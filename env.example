# Client-safe Supabase settings.
# In Vercel, set Preview to an isolated Preview database and Production to the live database.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only credential. Never prefix this with NEXT_PUBLIC_.
# Use the matching environment's service-role key (Preview branch key vs Production key).
SUPABASE_SERVICE_ROLE_KEY=your_server_only_supabase_service_role_key
